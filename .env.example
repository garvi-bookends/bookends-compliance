# Copy to .env (which git ignores). On Vercel, set the same names under Project → Settings → Environment Variables.

# The database the app uses. Local: your PostgreSQL. Vercel: Supabase's "Transaction pooler" string (port 6543).
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/bookends_compliance

# Team access code for first-time setup (creating the first Compliance Head). It also signs everyone's session cookie,
# so changing it signs everyone out. Use a long random value in production.
ACCESS_CODE=choose-a-local-test-code

# Photos. Leave empty locally (they go to .data/files). On Vercel it is added for you when you connect a Blob store.
# BLOB_READ_WRITE_TOKEN=

# Business-day boundary in minutes from UTC. 330 = IST (default).
# TZ_OFFSET_MINUTES=330
